PROTOTYPE VOID op_create(USER_FUNCTION user_fn, LOGICAL commute, OP_OUT op)
{
    int c_ierr;
    MPI_Op c_op;

    /* user_fn is a Fortran procedure: the flag set below tells Open MPI
       to call it with Fortran arguments. */
    c_ierr = @INNER_CALL@(user_fn,
                          OMPI_FINT_2_INT(*commute),
                          &c_op);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);

    if (MPI_SUCCESS == c_ierr) {
        c_op->o_flags |= OMPI_OP_FLAGS_FORTRAN_FUNC;
        *op = PMPI_Op_c2f(c_op);
    }
}
