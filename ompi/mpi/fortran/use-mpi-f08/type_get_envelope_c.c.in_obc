/*
 * The large count version of MPI_Type_get_envelope; see
 * type_get_envelope.c.in_nbc.
 */
PROTOTYPE VOID type_get_envelope_c(DATATYPE datatype,
                                   COUNT_OUT num_integers,
                                   COUNT_OUT num_addresses,
                                   COUNT_OUT num_large_counts,
                                   COUNT_OUT num_datatypes,
                                   INT_OUT combiner)
{
    int c_ierr;
    MPI_Datatype c_type = PMPI_Type_f2c(*datatype);
    int c_combiner;

    c_ierr = @INNER_CALL@(c_type,
                          num_integers,
                          num_addresses,
                          num_large_counts,
                          num_datatypes,
                          &c_combiner);
    if (MPI_SUCCESS == c_ierr) {
        *combiner = OMPI_INT_2_FINT(c_combiner);
    }
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
}
