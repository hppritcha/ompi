/*
 * The Fortran callbacks are registered through C intercepts; see
 * base/datarep_f08.h.
 */
PROTOTYPE VOID register_datarep(CHAR_ARRAY datarep,
                                DATAREP_CONVERSION_FN read_conversion_fn,
                                DATAREP_CONVERSION_FN write_conversion_fn,
                                DATAREP_EXTENT_FN dtype_file_extent_fn,
                                AINT extra_state)
{
    int c_ierr;
    /* For MPI_Register_datarep_c, the _c types, fields and intercepts */
    MPI_Datarep_conversion_function@BIGCOUNT_SUFFIX@ *c_read_fn = NULL;
    MPI_Datarep_conversion_function@BIGCOUNT_SUFFIX@ *c_write_fn = NULL;
    ompi_f08_datarep_intercept_t *intercept;

    intercept = ompi_f08_datarep_intercept_create();
    if (NULL == intercept) {
        c_ierr = OMPI_ERRHANDLER_INVOKE(MPI_FILE_NULL, MPI_ERR_NO_MEM,
                                        FUNC_NAME);
        if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
        return;
    }

    /* The Fortran wrapper passes MPI_CONVERSION_FN_NULL{_C} as NULL; pass
       it on as the C MPI_CONVERSION_FN_NULL{_C}, so that no conversion is
       done, rather than through an intercept. */
    if (NULL != read_conversion_fn) {
        intercept->read_fn@BIGCOUNT_SUFFIX@ = read_conversion_fn;
        c_read_fn = ompi_f08_datarep_read_intercept@BIGCOUNT_SUFFIX@;
    }
    if (NULL != write_conversion_fn) {
        intercept->write_fn@BIGCOUNT_SUFFIX@ = write_conversion_fn;
        c_write_fn = ompi_f08_datarep_write_intercept@BIGCOUNT_SUFFIX@;
    }
    intercept->extent_fn = dtype_file_extent_fn;
    intercept->extra_state = *extra_state;

    c_ierr = @INNER_CALL@(datarep, c_read_fn, c_write_fn,
                          ompi_f08_datarep_extent_intercept, intercept);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
}
