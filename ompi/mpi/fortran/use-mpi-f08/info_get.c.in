PROTOTYPE VOID info_get(INFO info, CHAR_ARRAY key, INT valuelen,
                        CHAR_ARRAY_OUT value:valuelen, LOGICAL_OUT flag)
{
    int c_ierr, c_flag;
    MPI_Info c_info = PMPI_Info_f2c(*info);
    char *c_value;

    if (*valuelen < 0) {
        c_ierr = OMPI_ERRHANDLER_NOHANDLE_INVOKE(MPI_ERR_ARG, FUNC_NAME);
        if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
        return;
    }

    /* value is CHARACTER(LEN=valuelen); leave room for the '\0' */
    c_value = (char *) malloc(value_len + 1);
    if (NULL == c_value) {
        c_ierr = OMPI_ERRHANDLER_NOHANDLE_INVOKE(MPI_ERR_NO_MEM, FUNC_NAME);
        if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
        return;
    }

    c_ierr = @INNER_CALL@(c_info, key, OMPI_FINT_2_INT(*valuelen),
                          c_value, &c_flag);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);

    if (MPI_SUCCESS == c_ierr) {
        if (c_flag) {
            ompi_fortran_string_c2f(c_value, value, value_len);
        }
        *flag = OMPI_INT_2_FINT(c_flag);
    }
    free(c_value);
}
