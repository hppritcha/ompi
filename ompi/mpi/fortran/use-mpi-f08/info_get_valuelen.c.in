PROTOTYPE VOID info_get_valuelen(INFO info, CHAR_ARRAY key, INT_OUT valuelen,
                                 LOGICAL_OUT flag)
{
    int c_ierr, c_valuelen, c_flag;
    MPI_Info c_info = PMPI_Info_f2c(*info);

    c_ierr = @INNER_CALL@(c_info, key, &c_valuelen, &c_flag);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);

    if (MPI_SUCCESS == c_ierr) {
        if (c_flag) {
            *valuelen = OMPI_INT_2_FINT(c_valuelen);
        }
        *flag = OMPI_INT_2_FINT(c_flag);
    }
}
