PROTOTYPE VOID grequest_start(GREQUEST_QUERY_FN query_fn,
                              GREQUEST_FREE_FN free_fn,
                              GREQUEST_CANCEL_FN cancel_fn,
                              AINT extra_state, REQUEST_OUT request)
{
    int c_ierr;
    MPI_Request c_req;

    c_ierr = @INNER_CALL@(query_fn, free_fn, cancel_fn, NULL, &c_req);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);

    if (MPI_SUCCESS == c_ierr) {
        /* Manually override the function pointer type flag on the
           grequest to indicate that these are Fortran functions */
        ompi_grequest_t *g = (ompi_grequest_t *) c_req;
        g->greq_funcs_are_c = false;

        /* The Fortran callbacks take extra_state by reference.  Give them
           the address of a copy kept in the request: extra_state is
           INTENT(IN), and the caller's variable (or the temporary holding
           an expression) need not outlive this call. */
        g->greq_fortran_state = *extra_state;
        g->greq_state = &g->greq_fortran_state;

        *request = PMPI_Request_c2f(c_req);
    }
}
