/*
 * The large count version has an extra num_large_counts argument, so it
 * has its own template, type_get_envelope_c.c.in_obc.
 */
PROTOTYPE VOID type_get_envelope(DATATYPE datatype,
                                 COUNT_OUT num_integers,
                                 COUNT_OUT num_addresses,
                                 COUNT_OUT num_datatypes,
                                 INT_OUT combiner)
{
    int c_ierr;
    MPI_Datatype c_type = PMPI_Type_f2c(*datatype);
    @COUNT_TYPE@ c_num_integers, c_num_addresses, c_num_datatypes;
    int c_combiner;

    c_ierr = @INNER_CALL@(c_type,
                          &c_num_integers,
                          &c_num_addresses,
                          &c_num_datatypes,
                          &c_combiner);
    if (MPI_SUCCESS == c_ierr) {
        *num_integers = (@COUNT_FINT_TYPE@) c_num_integers;
        *num_addresses = (@COUNT_FINT_TYPE@) c_num_addresses;
        *num_datatypes = (@COUNT_FINT_TYPE@) c_num_datatypes;
        *combiner = OMPI_INT_2_FINT(c_combiner);
    }
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
}
