PROTOTYPE VOID session_get_nth_pset(SESSION session, INFO info, INT n,
                                    INT_INOUT pset_len, CHAR_ARRAY_OUT pset_name)
{
    int c_ierr, c_len, c_bufsize = MPI_MAX_PSET_NAME_LEN;
    size_t name_len;
    MPI_Session c_session = PMPI_Session_f2c(*session);
    MPI_Info c_info = PMPI_Info_f2c(*info);
    char c_name[MPI_MAX_PSET_NAME_LEN];

    /* In Fortran, pset_len is the number of characters available in
       pset_name, with no space needed for a '\0', and 0 only queries
       the length.  Never write beyond the actual Fortran string,
       whatever pset_len claims. */
    c_len = OMPI_FINT_2_INT(*pset_len);
    if (c_len < 0) {
        if (ompi_instance_invalid(c_session)) {
            c_ierr = OMPI_ERRHANDLER_NOHANDLE_INVOKE(MPI_ERR_ARG, FUNC_NAME);
        } else {
            c_ierr = OMPI_ERRHANDLER_INVOKE(c_session, MPI_ERR_ARG, FUNC_NAME);
        }
        if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
        return;
    }
    if (c_len > pset_name_len) {
        c_len = pset_name_len;
    }

    /* Always fetch the whole name so that its length can be returned */
    c_ierr = @INNER_CALL@(c_session, c_info, OMPI_FINT_2_INT(*n),
                          &c_bufsize, c_name);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);

    if (MPI_SUCCESS == c_ierr) {
        c_name[MPI_MAX_PSET_NAME_LEN - 1] = '\0';
        name_len = strlen(c_name);
        if (c_len > 0) {
            if ((size_t) c_len < name_len) {
                c_name[c_len] = '\0';
            }
            ompi_fortran_string_c2f(c_name, pset_name, pset_name_len);
        }
        /* The Fortran length does not include a '\0' */
        *pset_len = OMPI_INT_2_FINT((int) name_len);
    }
}
