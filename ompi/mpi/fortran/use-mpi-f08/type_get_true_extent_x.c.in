/*
 * The count arguments are always INTEGER(KIND=MPI_COUNT_KIND) and there
 * is no _c version, so use the COUNT_ONLY types, which, unlike the COUNT
 * types, do not generate one.
 */
PROTOTYPE VOID type_get_true_extent_x(DATATYPE datatype, COUNT_ONLY_OUT true_lb,
                                     COUNT_ONLY_OUT true_extent)
{
    int c_ierr;
    MPI_Datatype c_type = PMPI_Type_f2c(*datatype);

    c_ierr = @INNER_CALL@(c_type, true_lb, true_extent);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
}
