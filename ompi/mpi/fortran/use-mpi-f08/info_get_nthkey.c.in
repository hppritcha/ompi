PROTOTYPE VOID info_get_nthkey(INFO info, INT n, CHAR_ARRAY_OUT key)
{
    int c_ierr;
    MPI_Info c_info = PMPI_Info_f2c(*info);
    char c_key[MPI_MAX_INFO_KEY];

    c_ierr = @INNER_CALL@(c_info, OMPI_FINT_2_INT(*n), c_key);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);

    if (MPI_SUCCESS == c_ierr) {
        ompi_fortran_string_c2f(c_key, key, key_len);
    }
}
