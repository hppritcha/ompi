/*
 * The standard defines MPI_F_sync_reg without an ierror argument.  The
 * buffer is ASYNCHRONOUS and has no INTENT, so the compiler must assume
 * that the call may have read or modified it.
 */
PROTOTYPE VOID_NO_IERROR f_sync_reg(BUFFER_ASYNC_OUT x)
{
    /* This is a noop in C to disable potential Fortran optimizations. */
    return;
}
