PROTOTYPE VOID group_range_excl(GROUP group, INT n, RANGE_ARRAY ranges:n, GROUP_OUT newgroup)
{
    int c_ierr;
    MPI_Group c_group, c_newgroup;
    OMPI_2_DIM_ARRAY_NAME_DECL(ranges, 3);

    /* Make the fortran to c representation conversion */
    c_group = PMPI_Group_f2c(*group);

    OMPI_2_DIM_ARRAY_FINT_2_INT(ranges, *n, 3);
    c_ierr = @INNER_CALL@(c_group,
                          OMPI_FINT_2_INT(*n),
                          OMPI_ARRAY_NAME_CONVERT(ranges),
                          &c_newgroup);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);

    /* translate the results from c to fortran */
    if (MPI_SUCCESS == c_ierr) {
        *newgroup = PMPI_Group_c2f(c_newgroup);
    }

    OMPI_ARRAY_FINT_2_INT_CLEANUP(ranges);
}
