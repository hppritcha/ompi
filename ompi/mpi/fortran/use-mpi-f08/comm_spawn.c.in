PROTOTYPE VOID comm_spawn(CHAR_ARRAY command, STRING_ARRAY argv, INT maxprocs,
                          INFO info, INT root, COMM comm,
                          COMM_OUT intercomm, ERRCODES_ARRAY array_of_errcodes)
{
    MPI_Comm c_comm, c_intercomm;
    MPI_Info c_info;
    int c_ierr;
    int *c_errs;
    char **c_argv;
    OMPI_ARRAY_NAME_DECL(array_of_errcodes);

    c_comm = PMPI_Comm_f2c(*comm);
    c_info = PMPI_Info_f2c(*info);

    /* It's allowed to have no argv */

    if (OMPI_IS_FORTRAN_ARGV_NULL(argv)) {
        c_argv = MPI_ARGV_NULL;
    } else if (OMPI_SUCCESS != ompi_fortran_argv_blank_f2c(argv, argv_len,
                                                           argv_len, &c_argv)) {
        c_ierr = OMPI_ERRHANDLER_INVOKE(c_comm, MPI_ERR_NO_MEM, FUNC_NAME);
        if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
        return;
    }

    /* It's allowed to ignore the errcodes */

    if (OMPI_IS_FORTRAN_ERRCODES_IGNORE(array_of_errcodes)) {
        c_errs = MPI_ERRCODES_IGNORE;
    } else {
        /* Seed the temporary from the caller's array rather than just
           allocating it: MPI_Comm_spawn leaves the error codes untouched
           when it fails a parameter check, and the copy back below cannot
           tell that case apart from a failure of the spawn itself, which
           does fill them in.  Starting from the caller's own values makes
           the copy back a no-op in the former case, so the caller's array
           survives unchanged the way it does when a Fortran INTEGER is
           the same size as a C int and no temporary is used at all. */
        OMPI_ARRAY_FINT_2_INT(array_of_errcodes, OMPI_FINT_2_INT(*maxprocs));
        c_errs = OMPI_ARRAY_NAME_CONVERT(array_of_errcodes);
    }

    c_ierr = @INNER_CALL@(command, c_argv,
                          OMPI_FINT_2_INT(*maxprocs),
                          c_info,
                          OMPI_FINT_2_INT(*root),
                          c_comm, &c_intercomm, c_errs);
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);

    if (MPI_SUCCESS == c_ierr) {
        *intercomm = PMPI_Comm_c2f(c_intercomm);
    }

    if (!OMPI_IS_FORTRAN_ERRCODES_IGNORE(array_of_errcodes)) {
        OMPI_ARRAY_INT_2_FINT(array_of_errcodes, OMPI_FINT_2_INT(*maxprocs));
    }
    if (MPI_ARGV_NULL != c_argv) {
        ompi_fortran_argv_free(c_argv);
    }
}
