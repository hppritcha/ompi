PROTOTYPE VOID type_get_name(DATATYPE datatype, CHAR_ARRAY_OUT type_name:MPI_MAX_OBJECT_NAME,
                             INT_OUT resultlen)
{
    int c_ierr, c_len;
    MPI_Datatype c_datatype = PMPI_Type_f2c(*datatype);
    char c_name[MPI_MAX_OBJECT_NAME];

    c_ierr = @INNER_CALL@(c_datatype, c_name, &c_len);
    if (MPI_SUCCESS == c_ierr) {
        ompi_fortran_string_c2f(c_name, type_name, type_name_len);
        *resultlen = OMPI_INT_2_FINT(c_len);
    }
    if (NULL != ierr) *ierr = OMPI_INT_2_FINT(c_ierr);
}
